# PayPulse configuration
# Live is the default. Agent OS MCP uses OAuth — do NOT put Binance API secret keys here.
# No withdrawals. Live settle returns PENDING / AWAITING_CONFIRM / REJECTED honestly —
# never silent CONFIRMED_PAPER as a live success.

# Mode: live | paper | mock (live requires MCP host OAuth / wallet confirm)
PAYPULSE_MODE=live

# Binance x402 programmable payments
BINANCE_X402_URL=https://www.binance.com/binancex402
# Documented default daily x402 cap (USD) — NOT a guarantee; confirm in Binance App / wallet settings
X402_DOCUMENTED_DAILY_CAP_USD=20

# Binance Agent OS MCP (account / settlement context)
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
# MCP host-flexible OAuth client id (Grok is one optional example; other hosts may differ)
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=grok

# Risk limits (in addition to documented x402 cap)
MAX_PAYMENT_USD=15
DAILY_SPEND_CAP_USD=20
REQUIRE_CONFIRM=true
KILL_SWITCH=false

# Paper agent balances (USDT) — used for paper opt-in / seed context display
PAPER_BUYER_USDT=100
PAPER_SELLER_USDT=10
