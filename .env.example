# live (default) | paper | mock
PAYPULSE_MODE=live

# Persist ledger to disk (server default true; demo runner forces false)
PAYPULSE_PERSIST=true
PAYPULSE_LEDGER_PATH=.paypulse/ledger.json

# Local risk (pre-filter). Live x402 quota still comes from baw wallet settings when signed in.
MAX_PAYMENT_USD=15
DAILY_SPEND_CAP_USD=20
X402_DOCUMENTED_DAILY_CAP_USD=20
REQUIRE_CONFIRM=true
KILL_SWITCH=false

# Paper HMAC secret (dev default is fine; never use for live)
PAYPULSE_PAPER_SECRET=paypulse-paper-dev-secret

# Optional override of seller payTo (BSC 0x…)
# PAYPULSE_PAYTO_AGENT_SELLER_BRIEF=0x8B3a350e2f3E6B9cC6FB10Fd106bA08f08bec5D2
# PAYPULSE_PAYTO_AGENT_SELLER_SIGNALS=0x1111111111111111111111111111111111111111

# Agentic Wallet CLI (live buyer preview/sign + x402QuotaLeft)
PAYPULSE_BAW_BIN=baw

# MCP context rail (not used to settle)
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=grok

# Product page (docs only — not a settle endpoint)
BINANCE_X402_URL=https://www.binance.com/binancex402

# Standalone seller/API
PAYPULSE_PORT=8787
PAPER_BUYER_USDT=100
PAPER_SELLER_USDT=10
