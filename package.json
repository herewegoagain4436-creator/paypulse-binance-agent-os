{
  "name": "paypulse",
  "version": "1.1.0",
  "private": true,
  "description": "PayPulse — Agent-to-agent x402 payments (HTTP 402 → preview → sign → replay) with Binance Agent OS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "cli": "tsx src/cli/index.ts",
    "seller": "tsx src/server/listen.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
